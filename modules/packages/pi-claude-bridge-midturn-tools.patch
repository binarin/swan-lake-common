+/** What Claude Code sees of a tool set through tools/list, independent of tool order,
+ *  schema key order and object identity, so re-registering an identical tool does not
+ *  count as a change. */
+function toolsFingerprint(tools: readonly Tool[]): string {
+	return digest([...tools]
+		.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
+		.map((tool) => [tool.name, tool.description, sortedKeys(tool.parameters)]));
+}
+
+/** `value` with every object's keys in sorted order; arrays keep theirs. */
+function sortedKeys(value: unknown): unknown {
+	if (Array.isArray(value)) return value.map(sortedKeys);
+	if (value === null || typeof value !== "object") return value;
+	const object = value as Record<string, unknown>;
+	return Object.fromEntries(Object.keys(object).sort().map((key) => [key, sortedKeys(object[key])]));
+}
