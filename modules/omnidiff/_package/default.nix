# Copied from the nixpkgs submission for omnidiff
# (https://github.com/NixOS/nixpkgs/pull/581923), which is written for a
# released tag with a `cargoHash`. Here the source is the pinned checkout of
# github:binarin/omnidiff/swan-lake-current (see flake.nix), which is a branch
# head rather than a tag, so three things differ from the submission:
#
#   - `version` is read from that checkout's Cargo.toml instead of a literal,
#     so it cannot go stale when the input is bumped;
#   - `cargoLock` vendoring replaces `cargoHash`, which would otherwise have to
#     be recomputed for every bump;
#   - `nix-update-script` is dropped for the same reason: the update is `nix
#     flake update omnidiff`, and its changelog link is built from `version`.
{
  git,
  installShellFiles,
  lib,
  rustPlatform,
  src,
}:
let
  version = (builtins.fromTOML (builtins.readFile "${src}/Cargo.toml")).package.version;
in
rustPlatform.buildRustPackage (finalAttrs: {
  pname = "omnidiff";
  inherit version src;

  __structuredAttrs = true;

  cargoLock.lockFile = "${finalAttrs.src}/Cargo.lock";

  nativeBuildInputs = [ installShellFiles ];

  # The git review tests build a throwaway repository with the real `git`, which
  # the build sandbox does not otherwise provide. Check-time only: the binary
  # has no git dependency of its own.
  nativeCheckInputs = [ git ];

  # Default features only (`tui`), the product binary. The `stats` and
  # `test-fixtures` features gate upstream's dataset-analysis tools.
  cargoBuildFlags = [
    "--bin"
    "omnidiff"
  ];

  cargoTestFlags = [
    "--lib"
    "omnidiff"
  ];

  useNextest = true;

  postInstall = ''
    # Generated by the binary just built, from the same clap definition as
    # --help. A real file: installManPage reads the section from the file name.
    $out/bin/omnidiff util man > omnidiff.1
    installManPage omnidiff.1
    installShellCompletion --cmd omnidiff \
      --bash <($out/bin/omnidiff util completions bash) \
      --zsh <($out/bin/omnidiff util completions zsh) \
      --fish <($out/bin/omnidiff util completions fish)
  '';

  meta = {
    description = "Content-aware diff tool";
    homepage = "https://ivankovic.github.io/omnidiff/";
    changelog = "https://github.com/ivankovic/omnidiff/blob/v${version}/CHANGELOG.md";
    license = lib.licenses.agpl3Only;
    maintainers = with lib.maintainers; [ gs-101 ];
    mainProgram = "omnidiff";
    platforms = lib.platforms.linux ++ lib.platforms.windows;
  };
})
